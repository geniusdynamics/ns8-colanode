#
# This systemd unit starts a colanode instance using Podman.
# Most parts of this file come from podman-generate-systemd.
#

[Unit]
Description=Podman colanode.service
Requires=pgvector-app.service valkey-app.service minio-app.service server-app.service web-app.service 
Before=pgvector-app.service valkey-app.service minio-app.service server-app.service web-app.service 

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%S/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/colanode.pid %t/colanode.pod-id
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/colanode.pid  --pod-id-file %t/colanode.pod-id  --name colanode  --publish 127.0.0.1:${TCP_PORT}:80  --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/colanode.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/colanode.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/colanode.pod-id
PIDFile=%t/colanode.pid
Type=forking

[Install]
WantedBy=default.target
