[Unit]
Description=Podman  minio-app.service
BindsTo=colanode.service
After=colanode.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
EnvironmentFile=-%S/state/smarthost.env
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p tmp
ExecStartPre=/bin/rm -f %t/minio-app.pid %t/minio-app.ctr-id
ExecStartPre=-runagent discover-smarthost
ExecStart=/usr/bin/podman run --conmon-pidfile %t/minio-app.pid  --cidfile %t/minio-app.ctr-id --cgroups=no-conmon  --pod-id-file %t/colanode.pod-id --replace -d --name  minio-app  --volume miniodata:/data:Z   --env-file minio.env  ${MINIO_IMAGE}  
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/minio-app.ctr-id -t 10
ExecReload=/usr/bin/podman kill -s HUP minio-app
SyslogIdentifier=%u
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/minio-app.ctr-id
PIDFile=%t/minio-app.pid
Type=forking

[Install]
WantedBy=default.target
