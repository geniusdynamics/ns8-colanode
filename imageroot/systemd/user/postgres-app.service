[Unit]
Description=Podman postgres-app.service
BindsTo=colanode.service
After=colanode.service
Before=server-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
EnvironmentFile=-%E/state/passwords.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStopSec=70
TimeoutStartSec=180
ExecStartPre=/bin/rm -f %t/postgres-app.pid %t/postgres-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/postgres-app.pid \
    --cidfile %t/postgres-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/colanode.pod-id --replace -d --name postgres-app \
    --volume postgres-data:/var/lib/postgresql/data:Z \
    --env=POSTGRES_USER=colanode \
    --env=POSTGRES_DB=colanode \
    --env=POSTGRES_PASSWORD \
    --env=TZ=UTC \
    ${PGVECTOR_IMAGE}
# Block until the server accepts TCP connections: the initdb temporary
# server only listens on its UNIX socket, so -h 127.0.0.1 is required.
ExecStartPost=/usr/bin/bash -c "until podman exec postgres-app pg_isready -q -h 127.0.0.1 -U colanode -d colanode; do sleep 2; done"
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/postgres-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/postgres-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/postgres-app.pid
Type=forking

[Install]
WantedBy=default.target
