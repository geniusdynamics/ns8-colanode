[Unit]
Description=Podman server-app.service
BindsTo=colanode.service
After=colanode.service postgres-app.service valkey-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
EnvironmentFile=-%E/state/passwords.env
WorkingDirectory=%E/state
# The server exits when it cannot reach its dependencies: retry slowly,
# without hitting the systemd start rate limit.
Restart=always
RestartSec=5
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/server-app.pid %t/server-app.ctr-id
# config.json is generated by configure-module and refers to the secrets
# POSTGRES_URL and REDIS_URL with env:// pointers.
ExecStart=/usr/bin/podman run --conmon-pidfile %t/server-app.pid \
    --cidfile %t/server-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/colanode.pod-id --replace -d --name server-app \
    --volume server-storage:/var/lib/colanode/storage:Z \
    --volume ./config.json:/config.json:ro,Z \
    --env=CONFIG=/config.json \
    --env=POSTGRES_URL \
    --env=REDIS_URL \
    ${SERVER_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/server-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/server-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/server-app.pid
Type=forking

[Install]
WantedBy=default.target
