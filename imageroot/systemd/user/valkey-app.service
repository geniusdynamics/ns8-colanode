[Unit]
Description=Podman valkey-app.service
BindsTo=colanode.service
After=colanode.service
Before=server-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
EnvironmentFile=-%E/state/passwords.env
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
TimeoutStartSec=120
ExecStartPre=/bin/rm -f %t/valkey-app.pid %t/valkey-app.ctr-id
# The password is read from the container environment by the shell: it
# does not appear in the unit.
ExecStart=/usr/bin/podman run --conmon-pidfile %t/valkey-app.pid \
    --cidfile %t/valkey-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/colanode.pod-id --replace -d --name valkey-app \
    --volume valkey-data:/data:Z \
    --env=VALKEY_PASSWORD \
    ${VALKEY_IMAGE} \
    sh -c 'exec valkey-server --requirepass "$$VALKEY_PASSWORD"'
ExecStartPost=/usr/bin/bash -c "until podman exec valkey-app sh -c 'REDISCLI_AUTH=$$VALKEY_PASSWORD valkey-cli ping' | grep -q PONG; do sleep 1; done"
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/valkey-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/valkey-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/valkey-app.pid
Type=forking

[Install]
WantedBy=default.target
