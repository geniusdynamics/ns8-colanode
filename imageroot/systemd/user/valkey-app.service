[Unit]
Description=Podman  valkey-app.service
BindsTo=colanode.service
After=colanode.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
EnvironmentFile=-%S/state/smarthost.env
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p tmp
ExecStartPre=/bin/rm -f %t/valkey-app.pid %t/valkey-app.ctr-id
ExecStartPre=-runagent discover-smarthost
ExecStart=/usr/bin/podman run --conmon-pidfile %t/valkey-app.pid  --cidfile %t/valkey-app.ctr-id --cgroups=no-conmon  --pod-id-file %t/colanode.pod-id --replace -d --name  valkey-app  --volume valkeydata:/data:Z   --env-file valkey.env  ${VALKEY_IMAGE}  
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/valkey-app.ctr-id -t 10
ExecReload=/usr/bin/podman kill -s HUP valkey-app
SyslogIdentifier=%u
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/valkey-app.ctr-id
PIDFile=%t/valkey-app.pid
Type=forking

[Install]
WantedBy=default.target
