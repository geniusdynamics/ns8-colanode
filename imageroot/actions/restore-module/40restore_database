set -e -o pipefail
exec 1>&2

# The backup holds passwords.env, so the restored database keeps the
# credentials the server uses. Load the dump into a fresh database with a
# throwaway PostgreSQL container.
# shellcheck disable=SC1091
source passwords.env
podman run --rm --detach --network=none --name=restore_db \
    --volume postgres-data:/var/lib/postgresql/data:Z \
    --env=POSTGRES_USER=colanode \
    --env=POSTGRES_DB=colanode \
    --env=POSTGRES_PASSWORD="${POSTGRES_PASSWORD}" \
    "${PGVECTOR_IMAGE}"
trap 'podman rm -f restore_db >/dev/null 2>&1 || true' EXIT
for _ in $(seq 1 60); do
    podman exec restore_db pg_isready -U colanode -d colanode >/dev/null 2>&1 && break
    sleep 2
done
podman exec --interactive restore_db pg_restore -U colanode -d colanode --clean --if-exists --no-owner < colanode.dump
podman stop restore_db
rm -f colanode.dump
