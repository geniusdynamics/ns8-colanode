import os
import secrets

# Database and Valkey passwords, and the connection URLs the server reads
# through the env:// pointers of config.json. Secrets must not go through
# agent.set_env(), which stores values in Redis: keep them in a private
# file, loaded by the systemd units and included in the module backup.
pg_password = secrets.token_hex(16)
valkey_password = secrets.token_hex(16)
path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fp:
    fp.write(f"POSTGRES_PASSWORD={pg_password}\n")
    fp.write(f"VALKEY_PASSWORD={valkey_password}\n")
    fp.write(f"POSTGRES_URL=postgres://colanode:{pg_password}@127.0.0.1:5432/colanode\n")
    fp.write(f"REDIS_URL=redis://:{valkey_password}@127.0.0.1:6379/0\n")
