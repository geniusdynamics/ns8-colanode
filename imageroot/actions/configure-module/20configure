import json
import os
import sys
import agent
import agent.tasks

request = json.load(sys.stdin)

host = request["host"]
http2https = request.get("http2https", True)
lets_encrypt = request.get("lets_encrypt", False)

agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", http2https)
agent.set_env("TRAEFIK_LETS_ENCRYPT", lets_encrypt)
agent.set_env("TCP_PORT", os.environ["TCP_PORTS"].split(",")[0])
agent.dump_env()

# Server configuration, read by the server container from /config.json.
# Secrets stay in passwords.env and are referenced with env:// pointers.
# Files are kept on the server-storage volume; the web client and the API
# share the host name (see etc/web-nginx.conf).
config = {
    "name": "Colanode",
    "web": {"domain": host},
    "mode": "standalone",
    "cors": {"origin": f"https://{host}", "maxAge": 7200},
    "account": {
        "verificationType": "automatic",
        "otpTimeout": 600,
        "google": {"enabled": False},
    },
    "postgres": {"url": "env://POSTGRES_URL"},
    "redis": {"url": "env://REDIS_URL", "db": 0, "eventsChannel": "events"},
    "storage": {
        "tus": {
            "locker": {"type": "redis", "prefix": "colanode:tus:lock"},
            "cache": {"type": "none"},
        },
        "provider": {"type": "file", "directory": "/var/lib/colanode/storage"},
    },
    "email": {"enabled": False},
    "logging": {"level": "info"},
}
with open("config.json", "w") as fp:
    json.dump(config, fp, indent=2)

response = agent.tasks.run(
    agent_id=agent.resolve_agent_id("traefik@node"),
    action="set-route",
    data={
        "instance": os.environ["MODULE_ID"],
        "url": "http://127.0.0.1:" + os.environ["TCP_PORT"],
        "host": host,
        "http2https": http2https,
        "lets_encrypt": lets_encrypt,
    },
)
agent.assert_exp(response["exit_code"] == 0, "The traefik set-route task failed!")
